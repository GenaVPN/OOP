<Window x:Class="LOGO_LABA_9_2.MainWindow"
        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900" Height="500"
        
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Grid>

       
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="#102030" Offset="0"/>
                <GradientStop Color="#070A12" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid.Resources>

            <LinearGradientBrush x:Key="NeonBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#00E5FF" Offset="0"/>
                <GradientStop Color="#4FC3F7" Offset="1"/>
            </LinearGradientBrush>

           
            <DropShadowEffect x:Key="Glow"
                              Color="#00E5FF"
                              BlurRadius="30"
                              ShadowDepth="0"
                              Opacity="0.85"/>

        </Grid.Resources>

       
        <Ellipse Width="360" Height="360"
                 Stroke="#1C2A3A"
                 StrokeThickness="2"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

        <Ellipse Width="300" Height="300"
                 Stroke="{StaticResource NeonBrush}"
                 StrokeThickness="4"
                 Opacity="0.7"
                 Effect="{StaticResource Glow}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

        
        <Polygon Points="450,120 560,185 560,315 450,380 340,315 340,185"
                 Fill="#0F1A2B"
                 Stroke="{StaticResource NeonBrush}"
                 StrokeThickness="4"
                 Effect="{StaticResource Glow}"/>

        
        <Line X1="450" Y1="150" X2="450" Y2="350"
              Stroke="#2C3E50"
              StrokeThickness="2"
              Opacity="0.6"/>

        <Line X1="420" Y1="170" X2="480" Y2="330"
              Stroke="#00E5FF"
              StrokeThickness="1"
              Opacity="0.4"/>

        <Line X1="480" Y1="170" X2="420" Y2="330"
              Stroke="#4FC3F7"
              StrokeThickness="1"
              Opacity="0.4"/>

        
        <TextBlock Text="GENOM"
                   FontSize="78"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI"
                   Effect="{StaticResource Glow}"/>

        

    </Grid>
</Window>
